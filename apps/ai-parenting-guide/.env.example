# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_parenting_guide
REDIS_URL=redis://localhost:6379/0

# Google AI Studio / Gemini API
GOOGLE_AI_API_KEY=your_gemini_api_key_here
GOOGLE_AI_PROJECT_ID=your_google_project_id

# JWT Authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# FastAPI Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AI Parenting Guide

# File Storage (AWS S3 or Google Cloud Storage)
STORAGE_PROVIDER=local  # local, s3, gcs
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=ai-parenting-guide-files
AWS_REGION=us-east-1

# Google Cloud Storage (if using GCS)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_STORAGE_BUCKET=ai-parenting-guide-files

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Development/Production Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Content Moderation
ENABLE_AI_MODERATION=true
MODERATION_CONFIDENCE_THRESHOLD=0.8